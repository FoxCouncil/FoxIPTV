<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:FoxIPTV.Services"
        x:Class="FoxIPTV.Views.ProviderWindow"
        Title="Fox IPTV - Provider"
        Icon="/Assets/FoxIPTV.ico"
        Width="460"
        MinWidth="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="16" Spacing="12">
        <Grid x:Name="FormGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider:" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <ComboBox x:Name="ServicesComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:IService">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="VersionLabel" Classes="muted" VerticalAlignment="Center" />
                <StackPanel x:Name="UpdatePanel" Orientation="Horizontal" IsVisible="False">
                    <TextBlock Text=" | " Classes="muted" VerticalAlignment="Center" />
                    <Button x:Name="UpdateLink" Classes="link" Content="Update Available" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="LoginButton" Grid.Column="1" Content="Start" Width="100" IsDefault="True" HorizontalContentAlignment="Center" />
        </Grid>
    </StackPanel>
</Window>
