<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoxIPTV.Views.ProviderWindow"
        Title="Fox IPTV - Provider"
        Icon="/Assets/FoxIPTV.ico"
        Width="460"
        MinWidth="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Choose a content provider" FontSize="16" FontWeight="Bold" />

        <Grid x:Name="ProviderGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto">
            <TextBlock x:Name="ProviderLabel" Grid.Column="0" Text="Provider:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
            <ComboBox x:Name="ServicesComboBox" Grid.Column="1" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{ReflectionBinding Title}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid x:Name="FieldsGrid" ColumnDefinitions="Auto,*" RowSpacing="6" />

        <TextBlock x:Name="NoFieldsLabel" Text="This provider needs no details, just press Start." Classes="muted" IsVisible="False" />

        <TextBlock x:Name="PluginErrorsLabel" Classes="warning" IsVisible="False" TextWrapping="Wrap" />

        <TextBlock x:Name="SigningInLabel" Classes="muted" IsVisible="False" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6,0,0">
            <Button x:Name="PluginsLinkButton" Grid.Column="0" Classes="link" Content="Open plugins folder" VerticalAlignment="Center" />
            <CheckBox x:Name="RememberMeCheckBox" Grid.Column="2" Content="Remember these details" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button x:Name="LoginButton" Grid.Column="3" Content="Start" Width="100" IsDefault="True" HorizontalContentAlignment="Center" />
        </Grid>
    </StackPanel>
</Window>
