<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:video="using:FoxIPTV.Playback.Video"
        xmlns:views="using:FoxIPTV.Views"
        x:Class="FoxIPTV.Views.MainWindow"
        Title="Fox IPTV"
        Icon="/Assets/FoxIPTV.ico"
        Width="1008" Height="537"
        MinWidth="240" MinHeight="240"
        WindowStartupLocation="CenterScreen"
        Background="Black">

    <DockPanel>
        <Border x:Name="StatusBar" Classes="statusbar" DockPanel.Dock="Bottom">
            <Grid ColumnDefinitions="*,Auto,*">
                <DockPanel Grid.Column="0" LastChildFill="True">
                    <views:InkTextBlock x:Name="ChannelStatusLabel" DockPanel.Dock="Left" Text="Channels:" Margin="0,0,4,0" />
                    <ProgressBar x:Name="ChannelStatusProgressBar" DockPanel.Dock="Left" Width="100" Minimum="0" Maximum="100" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <views:InkTextBlock x:Name="GuideStatusLabel" DockPanel.Dock="Left" Text="Guide:" Margin="0,0,4,0" />
                    <ProgressBar x:Name="GuideStatusProgressBar" DockPanel.Dock="Left" Width="100" Minimum="0" Maximum="100" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <views:InkTextBlock x:Name="PlayerStatusLabel" DockPanel.Dock="Left" Text="Waiting" Width="80" FontFamily="Consolas, Menlo, monospace" FontWeight="Bold" Foreground="SeaGreen" />
                    <views:InkTextBlock x:Name="TraceStatusLabel" Classes="muted" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                </DockPanel>
                <views:InkTextBlock x:Name="CcStatusLabel" Grid.Column="1" Text="CC" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CcOptionsButton" IsVisible="False" Focusable="False" Padding="4,0" Margin="8,0,8,0" FontSize="12" VerticalAlignment="Center">
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight" />
                        </Button.Flyout>
                    </Button>
                    <ProgressBar x:Name="BufferStatusProgressBar" Width="100" Minimum="0" Maximum="100" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Buffer" />
                    <views:InkTextBlock x:Name="TimeStatusLabel" Text="00:00" Width="44" TextAlignment="Right" FontFamily="Consolas, Menlo, monospace" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel>
            <video:VideoSurface x:Name="VideoView" />

            <Panel x:Name="OverlayPanel" Background="#01000000">
                <Panel.ContextMenu>
                    <ContextMenu x:Name="MainContextMenu">
                        <MenuItem x:Name="MenuItemChannelNumber" Header="&lt;ChannelNumber&gt;" FontWeight="Bold" />
                        <MenuItem x:Name="MenuItemChannelName" Header="&lt;ChannelName&gt;" />
                        <Separator />
                        <MenuItem x:Name="MenuItemChannelUp" Header="Channel Up" InputGesture="PageUp">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/arrow-090.png" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuItemChannelDown" Header="Channel Down" InputGesture="PageDown">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/arrow-270.png" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuItemWindowState" Header="Show Window" ToggleType="CheckBox" InputGesture="H" />
                        <MenuItem x:Name="MenuItemMute" Header="_Mute" ToggleType="CheckBox" InputGesture="Space" />
                        <Separator />
                        <MenuItem x:Name="MenuItemStatusBar" Header="_Status Bar" ToggleType="CheckBox" InputGesture="S" />
                        <MenuItem x:Name="MenuItemClosedCaptioning" Header="_Closed Captioning" ToggleType="CheckBox" InputGesture="C" />
                        <MenuItem x:Name="MenuItemBorders" Header="Borders" ToggleType="CheckBox" InputGesture="B" />
                        <MenuItem x:Name="MenuItemFullscreen" Header="_Fullscreen" ToggleType="CheckBox" InputGesture="F" />
                        <MenuItem x:Name="MenuItemAlwaysOnTop" Header="Always On Top" ToggleType="CheckBox" InputGesture="A" />
                        <Separator />
                        <MenuItem x:Name="MenuItemTransparency" Header="Transparency" ToggleType="CheckBox">
                            <MenuItem Header="0%" Tag="1.0" ToggleType="Radio" />
                            <MenuItem Header="10%" Tag=".9" ToggleType="Radio" />
                            <MenuItem Header="20%" Tag=".8" ToggleType="Radio" />
                            <MenuItem Header="30%" Tag=".7" ToggleType="Radio" />
                            <MenuItem Header="40%" Tag=".6" ToggleType="Radio" />
                            <MenuItem Header="50%" Tag=".5" ToggleType="Radio" />
                            <MenuItem Header="60%" Tag=".4" ToggleType="Radio" />
                            <MenuItem Header="70%" Tag=".3" ToggleType="Radio" />
                            <MenuItem Header="80%" Tag=".2" ToggleType="Radio" />
                            <MenuItem Header="90%" Tag=".1" ToggleType="Radio" />
                        </MenuItem>
                        <MenuItem x:Name="MenuItemAspectRatio" Header="Aspect Ratio">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/image-resize.png" Width="16" Height="16" />
                            </MenuItem.Icon>
                            <MenuItem Header="Default" Tag="null" ToggleType="Radio" />
                            <MenuItem Header="16:9" Tag="16:9" ToggleType="Radio" />
                            <MenuItem Header="4:3" Tag="4:3" ToggleType="Radio" />
                            <MenuItem Header="1:1" Tag="1:1" ToggleType="Radio" />
                            <MenuItem Header="16:10" Tag="16:10" ToggleType="Radio" />
                            <MenuItem Header="2.21:1" Tag="2.21:1" ToggleType="Radio" />
                            <MenuItem Header="2.35:1" Tag="2.35:1" ToggleType="Radio" />
                            <MenuItem Header="2.39:1" Tag="2.39:1" ToggleType="Radio" />
                            <MenuItem Header="5:4" Tag="5:4" ToggleType="Radio" />
                        </MenuItem>
                        <MenuItem x:Name="MenuItemStereoMode" Header="Stereo Mode">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/speaker.png" Width="16" Height="16" />
                            </MenuItem.Icon>
                            <MenuItem Header="Surround (5.1+)" Tag="5" ToggleType="Radio" />
                            <Separator />
                            <MenuItem Header="Stereo" Tag="1" ToggleType="Radio" />
                            <MenuItem Header="Reverse Stereo" Tag="2" ToggleType="Radio" />
                            <MenuItem Header="Left Channel" Tag="3" ToggleType="Radio" />
                            <MenuItem Header="Right Channel" Tag="4" ToggleType="Radio" />
                            <MenuItem Header="Mono" Tag="7" ToggleType="Radio" />
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuItemGuide" Header="Guide" ToggleType="CheckBox" InputGesture="G" />
                        <MenuItem x:Name="MenuItemChannelEditor" Header="Channel Editor" ToggleType="CheckBox" InputGesture="T" />
                        <MenuItem x:Name="MenuItemSettings" Header="Settings" ToggleType="CheckBox" InputGesture="Ctrl+OemComma" />
                        <Separator />
                        <MenuItem x:Name="MenuItemSwitchProvider" Header="Switch Provider...">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/arrow-switch.png" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuItemUpdate" Header="Check For Update">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/arrow-circle-double.png" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuItemAbout" Header="_About">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/question-white.png" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuItemQuit" Header="Quit">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/door--arrow.png" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Panel.ContextMenu>

                <Border x:Name="AdDimLayer" Background="Black" IsHitTestVisible="False" IsVisible="False" />

                <Panel x:Name="AdMediaPanel" Background="Black" IsHitTestVisible="False" IsVisible="False">
                    <Image x:Name="AdImage" Stretch="Uniform" IsVisible="False" />
                    <video:VideoSurface x:Name="AdVideo" Fill="True" IsVisible="False" />
                </Panel>

                <Border x:Name="AdTitleBox" Classes="osd" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48" IsHitTestVisible="False" IsVisible="False">
                    <views:InkTextBlock x:Name="AdTitleLabel" Classes="osd" FontSize="48" TextAlignment="Center" TextWrapping="Wrap" />
                </Border>

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,12,9,0" Spacing="12">
                    <Border x:Name="ChannelLabelBox" Classes="osd" HorizontalAlignment="Left" IsVisible="False">
                        <views:InkTextBlock x:Name="ChannelLabel" Classes="osd" FontSize="48" />
                    </Border>
                    <Border x:Name="ChannelNameLabelBox" Classes="osd" HorizontalAlignment="Left" IsVisible="False">
                        <views:InkTextBlock x:Name="ChannelNameLabel" Classes="osd" FontSize="27" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,9,0" Spacing="11">
                    <Border x:Name="MuteLabelBox" Classes="osd" HorizontalAlignment="Right" IsVisible="False">
                        <views:InkTextBlock x:Name="MuteLabel" Classes="osd" FontSize="29" Text="MUTE" />
                    </Border>
                    <StackPanel x:Name="TagPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" />
                </StackPanel>

                <Border x:Name="CaptionBox" Background="Black" Padding="12,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,48" IsVisible="False">
                    <views:InkTextBlock x:Name="CaptionLabel" FontFamily="{StaticResource OverlayFont}" FontSize="30" Foreground="White" TextAlignment="Left" TextWrapping="Wrap" />
                </Border>

                <Border x:Name="AdLabelBox" Background="Black" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9,0,0,12" IsVisible="False">
                    <views:InkTextBlock x:Name="AdLabel" FontFamily="{StaticResource OverlayFont}" FontSize="24" Foreground="Gold" />
                </Border>

                <Border x:Name="StatusMessageBox" Background="#404040" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12,0,12,12" Padding="8" IsVisible="True">
                    <views:InkTextBlock x:Name="StatusMessage" Text="Loading..." FontFamily="{StaticResource OverlayFont}" FontSize="21" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" />
                </Border>
            </Panel>
        </Panel>
    </DockPanel>
</Window>
