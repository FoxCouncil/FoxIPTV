<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoxIPTV.Views.AboutWindow"
        Title="Fox IPTV - About"
        Icon="/Assets/FoxIPTV.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="12" MinWidth="320">
        <TextBlock x:Name="TitleLabel" Text="Fox IPTV" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />

        <HeaderedContentControl Header="Support Us">
            <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PatreonButton" Classes="link" Content="Patreon," HorizontalAlignment="Center" />
                    <Button x:Name="GithubButton" Classes="link" Content="GitHub" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Licenses">
            <StackPanel>
                <StackPanel x:Name="LicenseLinks" Spacing="4" Margin="0,8" HorizontalAlignment="Center" />
                <Button x:Name="IconAttributionButton" Classes="link" Content="Icons by Yusuke Kamiyamane" HorizontalAlignment="Center" />
            </StackPanel>
        </HeaderedContentControl>

        <Button x:Name="CloseButton" Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Width="80" HorizontalContentAlignment="Center" />
    </StackPanel>
</Window>
