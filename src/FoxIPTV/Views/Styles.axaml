<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Secondary text -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <!-- Something went wrong but the window still works -->
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="#E0A030" />
    </Style>

    <!-- A button that reads as a link -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="#3C8CFF" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#6EAAFF" />
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <!-- The green on black on-screen display over the video -->
    <Style Selector="TextBlock.osd">
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="Lime" />
    </Style>
    <Style Selector="Border.osd">
        <Setter Property="Background" Value="Black" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- A stream tag: dark rounded box, bold white text -->
    <Style Selector="Border.tag">
        <Setter Property="Background" Value="#333333" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold Condensed, Bahnschrift, Arial Black, Arial" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The status bar along the bottom of the main window -->
    <Style Selector="Border.statusbar">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Border.statusbar TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
