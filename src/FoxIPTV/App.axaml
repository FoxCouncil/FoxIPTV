<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FoxIPTV.App"
             Name="FoxIPTV"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://FoxIPTV/Views/Styles.axaml" />
    </Application.Styles>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About FoxIPTV" Click="AboutMenuItem_Click" />
        </NativeMenu>
    </NativeMenu.Menu>
</Application>
