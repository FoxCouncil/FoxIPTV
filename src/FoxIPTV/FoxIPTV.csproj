<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FoxIPTV</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>3.0.0-alpha</Version>
    <AssemblyTitle>FoxIPTV</AssemblyTitle>
    <Product>FoxIPTV</Product>
    <Description>FoxIPTV - Cross-platform IPTV client</Description>
    <ApplicationIcon>Assets\FoxIPTV.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\FoxIPTV.icns;Assets\Lists\**;Assets\Fonts\OFL.txt" />
    <EmbeddedResource Include="Assets\Lists\*.gz" LogicalName="FoxIPTV.Lists.%(Filename)%(Extension)" />
    <AssemblyMetadata Include="SelfUpdate" Value="$(SelfUpdate)" Condition="'$(SelfUpdate)' == 'true'" />
  </ItemGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <PropertyGroup>
    <FFmpegRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FFmpegRid>
    <FFmpegRid Condition="'$(FFmpegRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</FFmpegRid>
    <FFmpegRid Condition="'$(FFmpegRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</FFmpegRid>
    <FFmpegRid Condition="'$(FFmpegRid)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</FFmpegRid>
    <FFmpegDir>$(MSBuildThisFileDirectory)..\..\native\$(FFmpegRid)\</FFmpegDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(FFmpegDir)**\*" Exclude="$(FFmpegDir)FFMPEG-LICENSE.txt" LogicalName="FoxIPTV.Native/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" Visible="false" />
    <EmbeddedResource Include="$(FFmpegDir)FFMPEG-LICENSE.txt" LogicalName="FoxIPTV.Licenses.FFMPEG-LICENSE.txt" Condition="Exists('$(FFmpegDir)FFMPEG-LICENSE.txt')" Visible="false" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="FoxIPTV.Licenses.LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="FoxIPTV.Licenses.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="Assets\Fonts\OFL.txt" LogicalName="FoxIPTV.Licenses.OFL.txt" />
  </ItemGroup>

  <Target Name="CheckFFmpeg" BeforeTargets="Build" Condition="!Exists('$(FFmpegDir)')">
    <Warning Text="FFmpeg is not built for $(FFmpegRid), playback will not work. Run build/ffmpeg.sh $(FFmpegRid) (see the script for the container command)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />

    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="Info.plist" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets/FoxIPTV.icns" Link="FoxIPTV.icns" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
